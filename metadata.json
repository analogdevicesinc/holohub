    "source_repository": "https://github.com/analogdevicesinc/holohub",
    "operator_names": ["IIOAttributeRead", "IIOAttributeWrite", "IIOBufferRead", "IIOBufferWrite", "IIOConfigurator"],
    "dependencies": [],
    "dockerfile": "Dockerfile",
    "documentation": {
      "readme": "README.md"
    },
    "testing": {
      "python": "pytest"
    }
  }
