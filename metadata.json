{
  "$schema": "urn:holoscan:module:v2",
  "module": {
    "name": "holoscan-iio-controller",
    "version": "1.0.0",
    "support_level": "community",
    "description": "IIO Controller operators for Analog Devices SDR hardware (ADALM-Pluto) via libiio v0/v1",
    "authors": [
      {
        "name": "Andrei-Fabian Pop",
        "affiliation": "Analog Devices Inc."
      },
      {
        "name": "Marius Lucacel",
        "affiliation": "Analog Devices Inc."
      }
    ],
    "license": "Apache-2.0",
    "language": ["C++", "Python"],
    "namespace": {
      "cpp": "holoscan::ops",
      "python": "holoscan.iio_controller"
    },
    "holoscan_sdk": {
      "minimum_required_version": "4.6.0",
      "tested_versions": ["4.6.0"]
    },
    "platforms": ["x86_64"],
